[Unit]
Description=spotifyd: Spotify device "Jarvis" on Jarvis's speaker
# Plays through the user's PipeWire session, like Jarvis.
After=pipewire.service pipewire-pulse.service wireplumber.service network-online.target
Wants=pipewire.service pipewire-pulse.service wireplumber.service

[Service]
ExecStart=%h/.local/bin/spotifyd --no-daemon --config-path %h/.config/spotifyd/spotifyd.conf --cache-path %h/.cache/spotifyd
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
