ANTHROPIC_API_KEY=
# Piper voice model (.onnx, with its .onnx.json next to it)
PIPER_VOICE=models/piper/en_GB-alan-medium.onnx
TTS_LENGTH_SCALE=1.0
TTS_VOLUME=1.0
# Audio devices: blank = system default, a number = index, text = name match (see: python -m sounddevice)
OUTPUT_DEVICE=
INPUT_DEVICE=
# Whisper model: tiny.en (fastest), base.en (default), small.en (most accurate, ~3x slower)
WHISPER_MODEL=base.en
WHISPER_THREADS=4
