ANTHROPIC_API_KEY=
# Claude model and reply cap (tokens)
CLAUDE_MODEL=claude-haiku-5-5
MAX_TOKENS=300
# How hard Claude thinks (low/medium/high; higher is slower) and how many past exchanges it remembers
CLAUDE_EFFORT=low
HISTORY_TURNS=10
# Claude Code model for project mode (sonnet, opus, ...)
PROJECT_MODEL=sonnet
# Front ends: the voice loop (on/off) and the Discord bot (runs when DISCORD_TOKEN is set)
VOICE_ENABLED=on
DISCORD_TOKEN=
# Your Discord user ID (Developer Mode on, right-click your name, Copy User ID)
DISCORD_OWNER_ID=
# In servers it answers you when @mentioned, or anything you write in this channel
DISCORD_CHANNEL=jarvis
# Alerts (timers, calendar records) are posted in that channel; on = @mention you in them
DISCORD_MENTION=on
# Apple Calendar (iCloud CalDAV): Apple ID email + an app-specific password from account.apple.com
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# Default calendar for new events (Claude picks another when it fits, e.g. Work)
ICLOUD_CALENDAR=Home
# Hour (0-23) of the morning briefing in #jarvis; deadline reminders and email alerts also go there
BRIEFING_HOUR=8
# Google (Gmail + Sheets): ID of the job-search sheet, the long part of its URL between /d/ and /edit
GOOGLE_SHEET_ID=
# Piper voice model (.onnx, with its .onnx.json next to it)
PIPER_VOICE=models/piper/en_GB-alan-medium.onnx
TTS_LENGTH_SCALE=1.0
TTS_VOLUME=1.0
# Audio devices: blank = system default, a number = index, text = name match (see: python -m sounddevice)
OUTPUT_DEVICE=
INPUT_DEVICE=
# Whisper model: large-v3-turbo (default, needs the GPU), or tiny.en / base.en / small.en for CPU
# WHISPER_DEVICE: cuda (RTX GPU, float16) or cpu (int8, uses WHISPER_THREADS)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_THREADS=4
# Wake word score needed to wake (0-1): raise if it wakes by itself, lower if it misses you
WAKE_THRESHOLD=0.5
# End of speech: Silero speech probability, and how long a pause ends what you're saying
SPEECH_THRESHOLD=0.5
SILENCE_SECONDS=0.8
MAX_UTTERANCE_SECONDS=15
# After a reply, how long to listen for a follow-up without the wake word
FOLLOW_UP_SECONDS=5
