ANTHROPIC_API_KEY=
# Claude model
CLAUDE_MODEL=claude-haiku-5-5
# How hard Claude thinks (low/medium/high; higher is slower)
CLAUDE_EFFORT=low
# Conversations are kept whole; past this many characters (about 120k tokens) the oldest
# exchanges are dropped, to stay inside Claude's context window
HISTORY_CHARS=480000
# Send each Claude request twice at once and use whichever starts answering first (on/off):
# cuts the occasional slow start (1.5-3 s) for a little more API cost
CLAUDE_RACE=on
# Claude Code model for project mode, on your Claude plan (sonnet, opus, ...)
PROJECT_MODEL=sonnet
# Front ends: the voice loop (on/off) and the Discord bot (runs when DISCORD_TOKEN is set)
VOICE_ENABLED=on
DISCORD_TOKEN=
# Your Discord user ID (Developer Mode on, right-click your name, Copy User ID)
DISCORD_OWNER_ID=
# In servers it answers you when @mentioned, or anything you write in this channel
DISCORD_CHANNEL=jarvis
# Alerts (timers, calendar records) are posted in that channel; on = @mention you in them
DISCORD_MENTION=on
# Claude sessions on any device reach Jarvis as an MCP server at /mcp/<MCP_TOKEN> (README):
# a long random secret (openssl rand -hex 32), and the local port Tailscale Funnel forwards to
MCP_TOKEN=
MCP_PORT=8766
# Apple Calendar (iCloud CalDAV): Apple ID email + an app-specific password from account.apple.com
ICLOUD_USER=
ICLOUD_APP_PASSWORD=
# Default calendar for new events (Claude picks another when it fits, e.g. Work)
ICLOUD_CALENDAR=Jarvis
# Morning briefing in #jarvis (H:MM), or this many minutes before a morning alarm if that's
# earlier; deadline reminders and email alerts also go there
BRIEFING_TIME=7:45
BRIEFING_BEFORE_ALARM=15
# Trello todos with a due date are reminded at these times (H:MM, comma separated) from the
# day before they're due until they're done
TODO_REMIND_TIMES=9:00,17:00
# Google (Gmail + Sheets): ID of the job-search sheet, the long part of its URL between /d/ and /edit
GOOGLE_SHEET_ID=
# Spotify: client ID of your app at developer.spotify.com/dashboard (README: Spotify setup)
SPOTIFY_CLIENT_ID=
# OneDrive: client ID of your app registration (README: OneDrive setup), and which accounts can
# sign in: common (any), consumers (personal Microsoft account), organizations, or e.g. queensu.ca
ONEDRIVE_CLIENT_ID=
ONEDRIVE_TENANT=common
# iMessage/SMS: the ssh host of the macOS VM running Messages (README: iMessage setup), e.g.
# jarvis-mac from ~/.ssh/config; empty until Messages is signed in there
IMESSAGE_SSH=
# Phone battery alerts (Find My on the same Mac VM): the phone's name in Find My (empty: your
# own iPhone) and the percentages to warn at
FINDMY_PHONE=
PHONE_WARN_AT=20,10
# Smith Learning (smithlearning.ca) username and password: optional, lets Jarvis sign in again
# by itself when the session expires (else: python -m jarvis.tools.onq login smith)
SMITH_USER=
SMITH_PASSWORD=
# Piper voice model (.onnx, with its .onnx.json next to it)
PIPER_VOICE=models/piper/en_GB-alan-medium.onnx
TTS_LENGTH_SCALE=1.0
TTS_VOLUME=1.0
# Audio devices: blank = system default, a number = index, text = name match (see: python -m sounddevice)
OUTPUT_DEVICE=
INPUT_DEVICE=
# Whisper model: large-v3-turbo (default, needs the GPU), or tiny.en / base.en / small.en for CPU
# WHISPER_DEVICE: cuda (RTX GPU, float16) or cpu (int8, uses WHISPER_THREADS)
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_THREADS=4
# Wake word score needed to wake (0-1): raise if it wakes by itself, lower if it misses you
WAKE_THRESHOLD=0.5
# Homecoming: clap twice, then "Daddy's home" (no wake word). Tune with python -m jarvis.clap:
# raise CLAP_PEAK_DB / CLAP_MIN_DBFS if it hears claps that weren't, lower them if it misses yours
HOMECOMING=on
CLAP_PEAK_DB=15
CLAP_MIN_DBFS=-40
# End of speech: Silero speech probability, and how long a pause ends what you're saying
SPEECH_THRESHOLD=0.5
SILENCE_SECONDS=0.8
# ...or this shorter pause when what you said is already a finished sentence (set it equal to
# SILENCE_SECONDS to always wait the full pause)
QUICK_SILENCE_SECONDS=0.5
MAX_UTTERANCE_SECONDS=15
# After a reply, how long to listen for a follow-up without the wake word
FOLLOW_UP_SECONDS=5
